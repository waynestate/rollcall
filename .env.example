# ROLLCALL settings. Copy to .env and fill in; .env is never committed.
# Every value here is a placeholder. Real tokens come from your secret store.

# CREED's policy.json (required for report and drift)
ROLLCALL_POLICY_FILE=./policy.json

# Where snapshots are written (the only place ROLLCALL writes)
ROLLCALL_STORE_DIR=./var/snapshots

# Where repositories come from: "directory" (fixtures, default) or "gitlab"
ROLLCALL_SOURCE=directory
ROLLCALL_REPOS_DIR=./tests/fixtures/repos

# GitLab (ROLLCALL_SOURCE=gitlab): a read_api token on a group or service account, never an api token
ROLLCALL_GITLAB_URL=https://gitlab.example.test
ROLLCALL_GITLAB_TOKEN=replace-with-a-read-api-token
ROLLCALL_GITLAB_GROUPS=group-or-path

# App list export (image tags) and PROCTOR JSON reports
ROLLCALL_IMAGES_FILE=./tests/fixtures/images.json
ROLLCALL_PROCTOR_DIR=./tests/fixtures/proctor

# Comma-separated Composer packages that count as an auth package (optional; overrides the defaults)
ROLLCALL_AUTH_PACKAGES=

# Metrics: off by default. When on, /metrics needs the bearer token or an allowlisted address.
ROLLCALL_METRICS_ENABLED=false
ROLLCALL_METRICS_TOKEN=
ROLLCALL_METRICS_ALLOW=

# Serve /report.json (public counts only) from the raw-PHP entry point or Laravel: off by default
ROLLCALL_PUBLIC_REPORT_ENABLED=false

# Laravel adapter only
ROLLCALL_DASHBOARD_ENABLED=false
ROLLCALL_DASHBOARD_PATH=rollcall
ROLLCALL_INTERNAL_ENABLED=false
ROLLCALL_WAYNEUI_CSS=
