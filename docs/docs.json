{
    "blocks": {
        "commands": {
            "type": "symfony-commands",
            "run": "php bin/rollcall",
            "cli": "rollcall",
            "level": 3
        },
        "env": {
            "type": "env",
            "scan": [
                "src",
                "bin",
                "config"
            ],
            "prefix": "ROLLCALL_",
            "describe": {
                "ROLLCALL_POLICY_FILE": [
                    "Path to CREED's policy.json",
                    "none (required for report, drift)"
                ],
                "ROLLCALL_STORE_DIR": [
                    "Snapshot directory, the only place Rollcall writes",
                    "`var/snapshots`"
                ],
                "ROLLCALL_SOURCE": [
                    "directory (fixtures) or gitlab",
                    "`directory`"
                ],
                "ROLLCALL_REPOS_DIR": [
                    "Fixture repositories as `<group>/<project>/composer.{json,lock}`",
                    "none"
                ],
                "ROLLCALL_GITLAB_URL": [
                    "https:// base URL of the GitLab instance",
                    "none"
                ],
                "ROLLCALL_GITLAB_TOKEN": [
                    "A GitLab bot or personal access token with the read_api scope only and an expiry, whose user can read only the projects to scan. Never in git, never logged, never printed",
                    "none"
                ],
                "ROLLCALL_GITLAB_GROUPS": [
                    "Comma-separated group ids or paths; subgroups are included. Ignored when ROLLCALL_GITLAB_PROJECTS is set",
                    "none"
                ],
                "ROLLCALL_GITLAB_PROJECTS": [
                    "Comma-separated full group/project paths; when set, only those projects are scanned and no group is listed",
                    "none"
                ],
                "ROLLCALL_IMAGES_FILE": [
                    "Export of the app list: {\"apps\": [{\"project\": \"group/project\", \"image\": \"php:8.4-apache\"}]}",
                    "none"
                ],
                "ROLLCALL_PROCTOR_DIR": [
                    "PROCTOR JSON reports, one per app: group/project is read from group__project.json",
                    "none"
                ],
                "ROLLCALL_AUTH_PACKAGES": [
                    "Comma-separated Composer packages that count as an auth package",
                    "the built-in list"
                ],
                "ROLLCALL_RETENTION_DAYS": [
                    "How many days of snapshots to keep; the newest is never deleted",
                    "`90` (0 keeps everything)"
                ],
                "ROLLCALL_METRICS_ENABLED": [
                    "Turn metrics on (CLI report --format=prometheus and /metrics)",
                    "`false`"
                ],
                "ROLLCALL_METRICS_TOKEN": [
                    "Bearer token a scraper must present",
                    "none"
                ],
                "ROLLCALL_METRICS_ALLOW": [
                    "Comma-separated scraper IP addresses (exact match)",
                    "none"
                ],
                "ROLLCALL_PUBLIC_REPORT_ENABLED": [
                    "Serve GET /report.json (public counts only)",
                    "`false`"
                ],
                "ROLLCALL_DASHBOARD_ENABLED": [
                    "Laravel: serve the dashboard page",
                    "`false`"
                ],
                "ROLLCALL_DASHBOARD_PATH": [
                    "Laravel: dashboard URL path",
                    "`rollcall`"
                ],
                "ROLLCALL_INTERNAL_ENABLED": [
                    "Laravel: serve the per-app page at `<path>/apps` (needs your sign-in middleware)",
                    "`false`"
                ],
                "ROLLCALL_WAYNEUI_CSS": [
                    "Laravel: https:// or absolute URL of WayneUI's stylesheet for the dashboard",
                    "none"
                ]
            }
        }
    }
}
