{
    "name": "waynestate/rollcall",
    "description": "WELD's fleet scanner: every app answers present with its PHP image, Laravel and auth-package versions and its PROCTOR result, checked against CREED's policy.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "nyholm/psr7": "^1.8",
        "promphp/prometheus_client_php": "^2.14",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "symfony/console": "^7.1",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "laravel/framework": "For the Laravel adapter: the dashboard page and the scheduled scan",
        "waynestate/wayne-ui": "Styles the Laravel dashboard page; until it is on Packagist, link its stylesheet with ROLLCALL_WAYNEUI_CSS"
    },
    "autoload": {
        "psr-4": {
            "Waynestate\\Rollcall\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Rollcall\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/rollcall"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Waynestate\\Rollcall\\Laravel\\RollcallServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: manifest, tests, style, static analysis, audit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
