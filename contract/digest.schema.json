{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/waynestate/rollcall/blob/main/contract/digest.schema.json",
    "title": "Rollcall owner digests",
    "description": "What `rollcall digest --format=json` prints: one entry per opted-in owner with news since the previous scan. Internal: it names apps and contacts.",
    "type": "object",
    "required": ["tool", "version", "visibility", "scan_date", "since", "opted_in", "quiet", "digests"],
    "additionalProperties": false,
    "properties": {
        "tool": {"const": "rollcall"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
        "visibility": {"const": "internal"},
        "scan_date": {"$ref": "#/$defs/date"},
        "since": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "opted_in": {"type": "integer", "minimum": 0},
        "quiet": {"type": "integer", "minimum": 0, "description": "Opted-in owners with nothing new: they get no digest"},
        "digests": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["to", "subject", "scan_date", "since", "apps", "changes", "standing", "body"],
                "additionalProperties": false,
                "properties": {
                    "to": {"type": "string", "minLength": 1},
                    "subject": {"type": "string", "pattern": "^Rollcall: \\d+ changes? in your apps \\(scan of \\d{4}-\\d{2}-\\d{2}\\)$"},
                    "scan_date": {"$ref": "#/$defs/date"},
                    "since": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
                    "apps": {"type": "array", "items": {"type": "string"}},
                    "changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                    "standing": {"type": "array", "items": {"type": "string"}},
                    "body": {"type": "string", "minLength": 1}
                }
            }
        }
    },
    "$defs": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }
}
