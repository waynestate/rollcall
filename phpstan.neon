# PHPStan runs on Pinstripe's raw preset (level 8 plus deprecation checks); this file adds only
# ROLLCALL's paths and PHP range.
includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
        - bin/rollcall
        - public
    phpVersion:
        min: 80300
        max: 80599
